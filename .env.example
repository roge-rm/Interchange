# Copy this to .env and edit it. docker compose reads it by itself.

# Needed: your own. The admin page can start a new game and kick players, so it won't start without one.
ADMIN_PASSWORD=

# The game's name in the list.
SERVER_NAME=Interchange

# 45688 is what the app tries first. Change it and players type "address:port".
GAME_PORT=45688

# Needed to join the game. Empty for none.
PASSWORD=

# false keeps the game off the local network's list.
LAN_DISCOVERY=true

# For a new game, and the admin page's new game form.
MAP_SIZE=256
SEED=
START_YEAR=1930
REGION=MIXED
RIVALS=2
DAY_LENGTH=10

# The admin page. 127.0.0.1 keeps it to this machine, reached over an SSH tunnel.
WEB_PORT=8088
WEB_BIND=0.0.0.0

# 1 only when a reverse proxy in front of the admin page serves HTTPS.
HTTPS=0

# Addresses whose X-Forwarded-For is believed: your reverse proxy's, comma separated.
FORWARDED_ALLOW_IPS=127.0.0.1
